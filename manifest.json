{
  "manifest_version": 3,
  "name": "Snabby",
  "version": "1.0.0",
  "description": "Snabby screenshot and OCR tool",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Snabby"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture visible viewport screenshot"
    }
  }
}
