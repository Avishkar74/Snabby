{
  "manifest_version": 3,
  "name": "Snabby",
  "version": "1.0.0",
  "description": "Snabby screenshot and OCR tool",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/popup.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Snabby"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture visible viewport screenshot"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/tesseract/*",
        "src/infrastructure/ocr/offscreen/offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
