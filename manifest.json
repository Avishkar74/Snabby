{
  "manifest_version": 3,
  "name": "Snabby",
  "version": "1.0.0",
  "description": "Snabby is a browser extension that lets you capture screenshots from any webpage across multiple tabs and combine them into a PDF. Just press Ctrl + Shift + S (or Cmd + Shift + S) and hit download. As simple as that. It also uses OCR to extract text from the captured screenshots.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/popup.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Snabby",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture visible viewport screenshot"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/tesseract/*",
        "src/infrastructure/ocr/offscreen/offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
